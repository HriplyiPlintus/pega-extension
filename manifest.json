{
    "name": "Pega Extension",
    "description": "Extends Pega functionality",
    "version": "0.0.1",
    "manifest_version": 3,
    "icons": {
        "16": "assets/img/icon.png",
        "32": "assets/img/icon.png",
        "48": "assets/img/icon.png",
        "128": "assets/img/icon.png"
    },
    "background": {
        "service_worker": "build/background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/img/icon.png",
            "32": "assets/img/icon.png",
            "48": "assets/img/icon.png",
            "128": "assets/img/icon.png"
        }
    },
    "permissions": ["storage", "tabs", "scripting", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/img/copy.png",
                "assets/img/done.png",
                "assets/img/copy-done.png",
                "assets/war/dev-portal.js",
                "assets/img/copy-hover-16.png",
                "assets/img/copy-hover.svg",
                "build/styles.css"
            ],
            "matches": [
                "https://srvcrp-digops-dt1.pegacloud.net/*",
                "https://srvcrp-digops-stg1.pegacloud.net/*",
                "https://srvcrp-digops-dt2.pegacloud.net/*",
                "https://srvcrp-digops-prod1.pegacloud.net/*",
                "https://srvcrp-digops-preprod1.pegacloud.net/*"
            ]
        }
    ]
}
