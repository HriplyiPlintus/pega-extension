{
    "name": "Pega Extension",
    "description": "Extends Pega functionality",
    "version": "0.0.0.3",
    "manifest_version": 3,
    "icons": {
        "16": "assets/img/icon.png",
        "32": "assets/img/icon.png",
        "48": "assets/img/icon.png",
        "128": "assets/img/icon.png"
    },
    "background": {
        "service_worker": "build/background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "assets/img/icon_grey-38.png"
    },
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/img/copy.png",
                "assets/img/done.png",
                "assets/img/copy-done.png",
                "assets/war/dev-portal.js",
                "assets/img/copy-hover-16.png",
                "assets/img/copy-hover.svg",
                "assets/img/log.png",
                "assets/img/copy-cursor.png",
                "assets/img/tag-mustard.png",
                "assets/img/tag-pega.png",
                "assets/img/tag-white.png",
                "assets/img/key.png",
                "assets/img/close.png",
                "assets/img/messy.png",
                "assets/img/tidy.png",
                "build/styles.css"
            ],
            "matches": [
                "https://*/*",
                "http://*/*"
            ]
        }
    ]
}
